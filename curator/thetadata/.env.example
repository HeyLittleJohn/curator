# Environment configuration for ThetaData Backfill
# Copy to .env and customize

# PostgreSQL connection string (required)
# THETADATA_DATABASE_URL=postgresql://user:password@localhost:5432/thetadata

# ThetaData API settings
THETADATA_API_BASE_URL=http://localhost:25503/v3
THETADATA_API_TIMEOUT=30
THETADATA_API_MAX_RETRIES=3
THETADATA_API_RATE_LIMIT=50

# Database pool settings
THETADATA_DB_POOL_MIN_SIZE=5
THETADATA_DB_POOL_MAX_SIZE=20

# Worker settings (defaults to CPU count if not set)
# THETADATA_WORKER_COUNT=8

# Batch size for database inserts
THETADATA_BATCH_SIZE=1000

# Default backfill mode: full or incremental
THETADATA_BACKFILL_MODE=full
